# Goals:
# - Linux releases can be published to Github automatically by Github Actions
#
# This Makefile is meant for machines

include Makefile

# Private ECR publishing for the Reevo fork.
# Configure these from CI (GitHub Actions variables) or on the command line:
#   ECR_REGISTRY - required, e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com
#   ECR_REPO     - defaults to vendored/chamber
#   FORK_SUFFIX  - optional fork build marker appended to the full version tag,
#                  e.g. FORK_SUFFIX=reevo.1 -> :v3.1.0-reevo.1
# Use strip/ifeq (not ?=/ifdef) so an empty-but-defined value from CI env
# (GitHub renders an unset `vars.*` as an empty string) falls back to the default.
ifeq ($(strip $(ECR_REPO)),)
	ECR_REPO := vendored/chamber
endif

# When FORK_SUFFIX is set, the full-version tag becomes <version>-<suffix>.
ifeq ($(strip $(FORK_SUFFIX)),)
	ECR_FULL_TAG := $(VERSION_NO_V)
else
	ECR_FULL_TAG := $(VERSION_NO_V)-$(FORK_SUFFIX)
endif

publish-ecr:
	@test -n "$(ECR_REGISTRY)" || { echo "ECR_REGISTRY is required"; exit 1; }
	docker buildx build \
		-t $(ECR_REGISTRY)/$(ECR_REPO):$(ECR_FULL_TAG) \
		-t $(ECR_REGISTRY)/$(ECR_REPO):$(VERSION_MAJOR_MINOR_PATCH) \
		-t $(ECR_REGISTRY)/$(ECR_REPO):$(VERSION_MAJOR_MINOR) \
		-t $(ECR_REGISTRY)/$(ECR_REPO):$(VERSION_MAJOR) \
		-t $(ECR_REGISTRY)/$(ECR_REPO):latest \
		--build-arg VERSION=$(VERSION) \
		--platform linux/amd64,linux/arm64 \
		--push \
		.

dist: dist/chamber-$(VERSION)-darwin-amd64 dist/chamber-$(VERSION)-darwin-arm64 dist/chamber-$(VERSION)-linux-amd64 dist/chamber-$(VERSION)-linux-arm64 dist/chamber-$(VERSION)-windows-amd64.exe dist/chamber_$(VERSION)_amd64.deb dist/chamber_$(VERSION)_amd64.rpm dist/chamber-$(VERSION).sha256sums

dist/chamber-$(VERSION).sha256sums: dist/chamber-$(VERSION)-darwin-amd64 dist/chamber-$(VERSION)-darwin-arm64 dist/chamber-$(VERSION)-linux-amd64 dist/chamber-$(VERSION)-linux-arm64 dist/chamber-$(VERSION)-windows-amd64.exe dist/chamber_$(VERSION)_amd64.deb dist/chamber_$(VERSION)_amd64.rpm
	sha256sum $^ | sed 's|dist/||g' > $@

dist/nfpm-$(VERSION).yaml: | dist/
	sed -e "s/\$${VERSION}/$(VERSION)/g" -e "s|\$${DIST_BIN}|dist/chamber-$(VERSION)-linux-amd64|g" < nfpm.yaml.tmpl > $@

dist/chamber_$(VERSION)_amd64.deb: dist/nfpm-$(VERSION).yaml dist/chamber-$(VERSION)-linux-amd64
	nfpm -f $< pkg --target $@

dist/chamber_$(VERSION)_amd64.rpm: dist/nfpm-$(VERSION).yaml dist/chamber-$(VERSION)-linux-amd64
	nfpm -f $< pkg --target $@

.PHONY: \
	publish-ecr
